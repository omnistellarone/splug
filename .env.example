# ─────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local
# AGENTS.md §28 / PLAN.md §4
# ─────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME=Splug Electronics

# Supabase — public keys are safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — SERVER-ONLY, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Paystack — SERVER-ONLY
PAYSTACK_SECRET_KEY=

# Paystack — safe to expose (used to initialize payment in browser if needed)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Mailgun — SERVER-ONLY
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=
MAILGUN_API_BASE_URL=https://api.mailgun.net

# Google OAuth — handled primarily via Supabase Dashboard.
# Only add here if application code directly consumes them.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
